{
  "format": "psp_localization_profile_v1",
  "id": "prinny",
  "name": "Prinny series",
  "platform": "PSP",
  "supported_inputs": ["iso", "cso", "directory"],
  "required_files": [
    "PSP_GAME/USRDIR/SYSTEM.DAT",
    "PSP_GAME/USRDIR/SCRIPT.DAT"
  ],
  "system_archive": "NISPACK",
  "runtime_archive": "start.lzs/start.dat",
  "text_encoding": "Shift-JIS with reassigned glyph codes",
  "font": {
    "resources": ["font.fnt", "font.txp", "jis2ucs.bin", "ucs2jis.bin"],
    "glyph_width": 20,
    "glyph_height": 14,
    "pixel_format": "4bpp"
  },
  "executable_text_sources": [
    "PSP_GAME/SYSDIR/BOOT.BIN",
    "PSP_GAME/SYSDIR/EBOOT.BIN"
  ],
  "notes": [
    "Prinny 2 compatibility is decided by runtime probing, not by title alone.",
    "Translations and fixed offsets are never copied from Prinny 1 to Prinny 2 without re-extraction."
  ]
}
