#!/usr/bin/env python3
from __future__ import annotations

import argparse
import sys
from pathlib import Path
from typing import Sequence

from core.text_catalog import (
    DEFAULT_OUTPUT_DIR as CATALOG_OUTPUT_DIR,
    DEFAULT_RUNTIME_DIR,
    build_catalog,
    save_catalog,
)
from core.text_curator import (
    DEFAULT_OUTPUT_DIR as CURATED_OUTPUT_DIR,
    DEFAULT_RAW_CATALOG,
    curate_catalog,
    save_curated_project,
)
from core.translation_exporter import (
    DEFAULT_OUTPUT_DIR as EXPORT_OUTPUT_DIR,
    DEFAULT_PROJECT,
    export_translation_package,
)


def run_catalog(
    arguments: argparse.Namespace,
) -> int:
    catalog = build_catalog(
        runtime_dir=arguments.runtime_dir,
    )

    save_catalog(
        catalog,
        output_dir=arguments.output_dir,
    )

    print("PRINNY TEXT CATALOG")
    print("===================")
    print(
        "SCANNED FILES :",
        catalog["scanned_files"],
    )
    print(
        "RESOURCES     :",
        catalog["resource_count"],
    )
    print(
        "TEXT ENTRIES  :",
        catalog["entry_count"],
    )
    print(
        "CATALOG SHA1  :",
        catalog["catalog_sha1"],
    )
    print("STATUS: PASS")
    return 0


def run_curate(
    arguments: argparse.Namespace,
) -> int:
    project = curate_catalog(
        raw_catalog_path=arguments.catalog,
        include_resources=(
            set(arguments.include)
            if arguments.include
            else None
        ),
        exclude_resources=(
            set(arguments.exclude)
            if arguments.exclude
            else None
        ),
        use_all_resources=(
            arguments.all_resources
        ),
        minimum_japanese_ratio=(
            arguments.minimum_japanese_ratio
        ),
        maximum_character_length=(
            arguments.maximum_length
        ),
    )

    save_curated_project(
        project,
        output_dir=arguments.output_dir,
    )

    print("PRINNY CURATED TEXT PROJECT")
    print("===========================")
    print(
        "RAW ENTRIES          :",
        project["raw_entry_count"],
    )
    print(
        "ACCEPTED OCCURRENCES :",
        project[
            "accepted_occurrence_count"
        ],
    )
    print(
        "UNIQUE TEXTS         :",
        project["unique_text_count"],
    )
    print(
        "RESOURCES            :",
        project["resource_count"],
    )
    print("STATUS: PASS")
    return 0


def run_export(
    arguments: argparse.Namespace,
) -> int:
    result = export_translation_package(
        project_path=arguments.project,
        output_dir=arguments.output_dir,
    )

    print("PRINNY TRANSLATOR PACKAGE")
    print("=========================")
    print(
        "TRANSLATION ENTRIES :",
        result["entry_count"],
    )
    print(
        "EXCLUDED NOISE      :",
        result["excluded_count"],
    )
    print(
        "PREFIXED ENTRIES    :",
        result["prefixed_count"],
    )
    print(
        "OUTPUT               :",
        result["output_dir"],
    )
    print("STATUS: PASS")
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="toolkit.py text",
        description=(
            "Prinny 문자열 추출 및 "
            "번역 프로젝트 관리 도구"
        ),
    )

    subparsers = parser.add_subparsers(
        dest="text_command",
        required=True,
        metavar="{catalog,curate,export}",
    )

    catalog_parser = (
        subparsers.add_parser(
            "catalog",
            help="원시 문자열을 추출합니다.",
        )
    )
    catalog_parser.add_argument(
        "--runtime-dir",
        type=Path,
        default=DEFAULT_RUNTIME_DIR,
    )
    catalog_parser.add_argument(
        "--output-dir",
        type=Path,
        default=CATALOG_OUTPUT_DIR,
    )
    catalog_parser.set_defaults(
        handler=run_catalog,
    )

    curate_parser = (
        subparsers.add_parser(
            "curate",
            help="실제 번역 후보를 정제합니다.",
        )
    )
    curate_parser.add_argument(
        "--catalog",
        type=Path,
        default=DEFAULT_RAW_CATALOG,
    )
    curate_parser.add_argument(
        "--output-dir",
        type=Path,
        default=CURATED_OUTPUT_DIR,
    )
    curate_parser.add_argument(
        "--include",
        action="append",
        default=None,
    )
    curate_parser.add_argument(
        "--exclude",
        action="append",
        default=None,
    )
    curate_parser.add_argument(
        "--all-resources",
        action="store_true",
    )
    curate_parser.add_argument(
        "--minimum-japanese-ratio",
        type=float,
        default=0.45,
    )
    curate_parser.add_argument(
        "--maximum-length",
        type=int,
        default=256,
    )
    curate_parser.set_defaults(
        handler=run_curate,
    )

    export_parser = (
        subparsers.add_parser(
            "export",
            help=(
                "번역자가 편집할 CSV와 "
                "JSON 패키지를 생성합니다."
            ),
        )
    )
    export_parser.add_argument(
        "--project",
        type=Path,
        default=DEFAULT_PROJECT,
    )
    export_parser.add_argument(
        "--output-dir",
        type=Path,
        default=EXPORT_OUTPUT_DIR,
    )
    export_parser.set_defaults(
        handler=run_export,
    )

    return parser


def main(
    argv: Sequence[str] | None = None,
) -> int:
    parser = build_parser()
    arguments = parser.parse_args(
        argv
    )

    try:
        return int(
            arguments.handler(
                arguments
            )
        )
    except (
        FileNotFoundError,
        KeyError,
        OSError,
        UnicodeError,
        ValueError,
        RuntimeError,
    ) as error:
        print(
            f"ERROR: {error}",
            file=sys.stderr,
        )
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
